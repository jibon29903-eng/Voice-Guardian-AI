rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidLanguage(lang) {
      return lang is string && lang in ['en', 'bn', 'ar'];
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() <= 80 &&
             isValidLanguage(data.preferredLanguage) &&
             (data.speechRate is float || data.speechRate is int) &&
             data.speechRate >= 0.5 && data.speechRate <= 2.0 &&
             data.voiceResponseEnabled is bool &&
             data.confirmSensitiveActions is bool &&
             data.memoryOptIn is bool &&
             data.wakePhraseEnabled is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidConversationMessage(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 64 &&
             data.role is string && data.role in ['user', 'assistant'] &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 16000 &&
             isValidLanguage(data.language) &&
             data.source is string && data.source in ['voice', 'chat', 'screen', 'research', 'whiteboard'] &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidVoiceCommand(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.transcript is string && data.transcript.size() >= 1 && data.transcript.size() <= 1000 &&
             data.responseSummary is string && data.responseSummary.size() <= 4000 &&
             isValidLanguage(data.language) &&
             data.wakeTriggered is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidStudioProject(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 2000 &&
             data.framework is string && data.framework in ['html_css_js', 'react_cdn'] &&
             data.htmlCode is string && data.htmlCode.size() <= 60000 &&
             data.cssCode is string && data.cssCode.size() <= 30000 &&
             data.jsCode is string && data.jsCode.size() <= 30000 &&
             data.lastDiagnostic is string && data.lastDiagnostic.size() <= 2000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidResearchBrief(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.query is string && data.query.size() >= 1 && data.query.size() <= 500 &&
             data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 16000 &&
             data.verificationNotes is string && data.verificationNotes.size() <= 4000 &&
             data.sourceTitles is list && data.sourceTitles.size() <= 20 &&
             (data.sourceTitles.size() == 0 || data.sourceTitles[0] is string) &&
             data.sourceUrls is list && data.sourceUrls.size() <= 20 &&
             (data.sourceUrls.size() == 0 || data.sourceUrls[0] is string) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidForexWatchItem(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.baseCurrency is string && data.baseCurrency.size() >= 3 && data.baseCurrency.size() <= 5 &&
             data.quoteCurrency is string && data.quoteCurrency.size() >= 3 && data.quoteCurrency.size() <= 5 &&
             (data.targetAlertRate is float || data.targetAlertRate is int) &&
             data.targetAlertRate >= 0.0 && data.targetAlertRate <= 1000000.0 &&
             data.alertDirection is string && data.alertDirection in ['above', 'below', 'none'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserMemory(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 1000 &&
             data.category is string && data.category in ['preference', 'shortcut', 'command'] &&
             data.approved is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'preferredLanguage', 'speechRate',
                         'voiceResponseEnabled', 'confirmSensitiveActions', 'memoryOptIn',
                         'wakePhraseEnabled', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'preferredLanguage', 'speechRate',
                         'voiceResponseEnabled', 'confirmSensitiveActions', 'memoryOptIn',
                         'wakePhraseEnabled', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'preferredLanguage', 'speechRate',
                         'voiceResponseEnabled', 'confirmSensitiveActions', 'memoryOptIn',
                         'wakePhraseEnabled', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /conversations/{messageId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(messageId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) &&
                         isValidId(userId) && isValidId(messageId) &&
                         incoming().keys().hasAll(['userId', 'sessionId', 'role', 'content', 'language', 'source', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'sessionId', 'role', 'content', 'language', 'source', 'createdAt']) &&
                         isValidConversationMessage(incoming(), userId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(messageId);
      }

      match /voice_commands/{commandId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(commandId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) &&
                         isValidId(userId) && isValidId(commandId) &&
                         incoming().keys().hasAll(['userId', 'transcript', 'responseSummary', 'language', 'wakeTriggered', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'transcript', 'responseSummary', 'language', 'wakeTriggered', 'createdAt']) &&
                         isValidVoiceCommand(incoming(), userId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(commandId);
      }

      match /studio_projects/{projectId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(projectId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) &&
                         isValidId(userId) && isValidId(projectId) &&
                         incoming().keys().hasAll(['userId', 'title', 'prompt', 'framework', 'htmlCode', 'cssCode', 'jsCode', 'lastDiagnostic', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'prompt', 'framework', 'htmlCode', 'cssCode', 'jsCode', 'lastDiagnostic', 'createdAt', 'updatedAt']) &&
                         isValidStudioProject(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(userId) && isValidId(projectId) &&
                         isValidStudioProject(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'prompt', 'framework', 'htmlCode', 'cssCode', 'jsCode', 'lastDiagnostic', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(projectId);
      }

      match /research_briefs/{briefId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(briefId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) &&
                         isValidId(userId) && isValidId(briefId) &&
                         incoming().keys().hasAll(['userId', 'query', 'summary', 'verificationNotes', 'sourceTitles', 'sourceUrls', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'query', 'summary', 'verificationNotes', 'sourceTitles', 'sourceUrls', 'createdAt']) &&
                         isValidResearchBrief(incoming(), userId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(briefId);
      }

      match /forex_watchlist/{pairId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(pairId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) &&
                         isValidId(userId) && isValidId(pairId) &&
                         incoming().keys().hasAll(['userId', 'baseCurrency', 'quoteCurrency', 'targetAlertRate', 'alertDirection', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'baseCurrency', 'quoteCurrency', 'targetAlertRate', 'alertDirection', 'createdAt', 'updatedAt']) &&
                         isValidForexWatchItem(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(userId) && isValidId(pairId) &&
                         isValidForexWatchItem(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'targetAlertRate', 'alertDirection', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(pairId);
      }

      match /memories/{memoryId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(memoryId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) &&
                         isValidId(userId) && isValidId(memoryId) &&
                         incoming().keys().hasAll(['userId', 'title', 'content', 'category', 'approved', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'content', 'category', 'approved', 'createdAt', 'updatedAt']) &&
                         isValidUserMemory(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(userId) && isValidId(memoryId) &&
                         isValidUserMemory(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'content', 'category', 'approved', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(memoryId);
      }
    }
  }
}
